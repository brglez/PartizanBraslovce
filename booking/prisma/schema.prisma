// Prisma schema for the Partizan Braslovče telovadnica booking platform.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum Sport {
  BADMINTON
  ODBOJKA
  KOSARKA
  REKREACIJA_SKUPINE
  SEDECA_ODBOJKA
  DRUGO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  phone               String?
  role                Role                 @default(MEMBER)
  // Whether this member wants to receive e-mail notifications (group term
  // changes, freed-up slots, ...). Members can still be booked/managed with
  // this off - it only gates outgoing notification e-mails.
  notifyOptIn         Boolean              @default(true)
  createdAt           DateTime             @default(now())
  bookings            Booking[]
  passwordResetTokens PasswordResetToken[]
  groups              Group[]
}

// A recreational group (e.g. "Četrtkova odbojka") a member can belong to -
// used to target e-mail notifications about that group's fixed term.
model Group {
  id           String        @id @default(cuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  members      User[]
  blockedSlots BlockedSlot[]
}

// Single-use, time-limited token e-mailed to a member so they can set a
// new password without an admin's help.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A single hourly slot in the telovadnica. One booking = the whole hall.
model Booking {
  id         String        @id @default(cuid())
  sport      Sport
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(PENDING)

  // Set when a logged-in member makes the booking (auto-confirmed).
  userId     String?
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Filled in for guest bookings (no account, awaits admin approval).
  guestName  String?
  guestEmail String?
  guestPhone String?

  notes      String?

  // Placeholder for a future online-payment flow (not wired up yet).
  paymentStatus String?    @default("NONE")

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([startTime, endTime])
  @@index([status])
}

// Singleton (id is always 1) holding the hall's operating hours, editable by
// an admin instead of being hard-coded.
model HallSettings {
  id             Int      @id @default(1)
  openingHour    Int      @default(8)
  closingHour    Int      @default(22)
  // Days the hall doesn't operate at all, 0=Sunday..6=Saturday (JS Date.getDay()).
  closedWeekdays Int[]    @default([])
  updatedAt      DateTime @updatedAt
}

// Admin-blocked periods (maintenance, tournaments, closures) - no booking may overlap these.
model BlockedSlot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  reason    String
  // Which activity occupies the slot, so the calendar can show its icon
  // (e.g. so the next/previous booking knows whether to take the net down).
  sport     Sport?
  createdAt DateTime @default(now())

  // Set when this fixed term belongs to a recreational group - its members
  // (who opted in) get e-mailed when the term is added or removed.
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  // Set when this slot was generated as one occurrence of a recurring block
  // (e.g. "every Thursday, whole season"), so the whole series can be
  // managed/removed together. Null for one-off blocks.
  seriesId  String?

  @@index([startTime, endTime])
  @@index([seriesId])
  @@index([groupId])
}
